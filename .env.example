# Copia in .env (o imposta le stesse variabili nel pannello Node.js di SiteGround).

# Indirizzo pubblico del sito, senza barra finale. Serve per link nelle email e ritorno da Stripe.
BASE_URL=https://www.daninktattoo.it
# Porta su cui ascolta l'app (SiteGround di solito la imposta da sé).
PORT=3000
# 1 se l'app sta dietro un proxy (SiteGround): legge l'IP reale per i limiti anti-abuso.
TRUST_PROXY=1

# Dati: database SQLite e immagini allegate ai messaggi. Fuori da public_html, inclusi nei backup.
DB_FILE=data/daninktattoo.db
UPLOADS_DIR=data/uploads

# Pannello /admin — genera l'hash con: npm run hash-password
ADMIN_PASSWORD_HASH=
# Stringa casuale di almeno 32 caratteri: openssl rand -hex 32
SESSION_SECRET=

# Stripe (dashboard.stripe.com → Sviluppatori). In prova usa le chiavi sk_test_...
STRIPE_SECRET_KEY=
# Segreto dell'endpoint webhook https://<dominio>/api/stripe/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Email (casella creata su SiteGround → Email → Account). Porta 465 = SSL.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DANINK <info@daninktattoo.it>"
# Dove arrivano richieste di contatto e avvisi di vendita.
NOTIFY_TO=

# Calendario: istanza Cal.diy (es. https://cal.daninktattoo.it) oppure https://app.cal.com
CAL_ORIGIN=https://cal.daninktattoo.it
# Utente/tipo di evento, es. dani/consulenza
CAL_LINK=dani/consulenza
